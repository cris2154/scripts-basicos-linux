{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "position": "left",
    "color": { "1": "38;2;196;181;253", "2": "38;2;167;139;250", "3": "38;2;139;92;246" },
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "",
    "disableLinewrap": true,
    "key": { "width": 8 },
    "color": { "keys": "38;2;109;40;217", "output": "38;2;237;233;254" },
    "temp": { "ndigits": 0 },
    "percent": { "type": ["bar", "num"], "ndigits": 0 },
    "bar": {
      "width": 10,
      "char": { "elapsed": "━", "total": "─" },
      "border": { "left": "", "right": "" },
      "color": { "elapsed": "38;2;167;139;250", "total": "38;2;76;29;149" }
    }
  },
  "modules": [
    "break", "break", "break",
    { "type": "custom", "format": "╭──────────────────────╮", "outputColor": "38;2;109;40;217" },
    { "type": "cpu",    "key": "│  {#38;2;196;181;253}CPU{#}", "temp": true, "format": "{temperature}           {#38;2;109;40;217}│" },
    { "type": "gpu",    "key": "│  {#38;2;196;181;253}GPU{#}", "hideType": "integrated", "temp": true, "format": "{temperature}           {#38;2;109;40;217}│" },
    { "type": "memory", "key": "│  {#38;2;196;181;253}RAM{#}", "format": "{percentage-bar} {percentage} {#38;2;109;40;217}│" },
    { "type": "custom", "format": "╰──────────────────────╯", "outputColor": "38;2;109;40;217" }
  ]
}
