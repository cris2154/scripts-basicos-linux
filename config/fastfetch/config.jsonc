{
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "position": "top",
    "color": {
      "1": "38;2;56;189;248",
      "2": "38;2;103;232;249",
      "3": "38;2;129;212;250"
    },
    "padding": { "top": 0, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "disableLinewrap": true,
    "color": {
      "keys": "38;2;56;189;248",
      "separator": "38;2;37;99;235"
    },
    "key": { "width": 5 },
    "percent": { "type": ["bar", "num"] },
    "bar": {
      "width": 10,
      "char": { "elapsed": "━", "total": "─" },
      "color": {
        "elapsed": "38;2;56;189;248",
        "total": "38;2;15;41;82"
      }
    }
  },
  "modules": [
    { "type": "cpu", "key": "CPU", "temp": true, "format": "{temperature}" },
    { "type": "gpu", "key": "GPU", "hideType": "integrated", "temp": true, "format": "{name} · {temperature}" },
    { "type": "memory", "key": "RAM", "format": "{percentage-bar} {used} / {total} ({percentage})" }
  ]
}
