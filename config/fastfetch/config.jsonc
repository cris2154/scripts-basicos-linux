// Made by MHIA (Adapted & Fixed for AMD / Fedora)
// Github: https://github.com/MHashir09

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "color": {"1": "38;2;167;139;250", "2": "38;2;167;139;250", "3": "38;2;167;139;250", "4": "38;2;167;139;250", "5": "38;2;167;139;250", "6": "38;2;167;139;250", "7": "38;2;167;139;250", "8": "38;2;167;139;250", "9": "38;2;167;139;250"},
        "source": "~/.config/fastfetch/logo/logo.txt",
        "padding": {
            "top": 1,
            "right": 5,
            "left": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {"keys": "38;2;167;139;250", "title": "38;2;167;139;250", "output": "38;2;167;139;250", "separator": "38;2;167;139;250"}
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "╭─────────────────────────────────────────╮"
        },
        {
            "type": "custom",
            "key": "│                                         │"
        },
        {
            "type": "command",
            "key": "│  OS           ",
            "text": "source /etc/os-release && echo \"$NAME $VERSION_ID\"",
            "format": "{>22}  │"
        },
        {
            "type": "command",
            "key": "│  Kernel       ",
            "text": "uname -r | cut -d '-' -f1",
            "format": "{>22}  │"
        },
        {
            "type": "command",
            "key": "│  Uptime       ",
            "text": "uptime -p | sed -E 's/up //; s/ days?/d/g; s/ hours?/h/g; s/ minutes?/m/g'",
            "format": "{>22}  │"
        },
        {
            "type": "shell",
            "key": "│  Shell        ",
            "format": "{pretty-name>22}  │"
        },
        {
            "type": "command",
            "key": "│  WM           ",
            "text": "echo ${XDG_CURRENT_DESKTOP:-GNOME}",
            "format": "{>22}  │"
        },
        {
            "type": "command",
            "key": "│  Ram          ",
            "text": "free -m | awk 'NR==2{printf \"%.2f / %.2f GiB\",$3/1024,$2/1024}'",
            "format": "{>22}  │"
        },
        {
            "type": "cpu",
            "key": "│  CPU          ",
            "format": "{name>22}  │"
        },
        {
            "type": "disk",
            "key": "│  Disk         ",
            "format": "{size-used} / {size-total>10}  │"
        },
        {
            "type": "packages",
            "key": "│  Packages     ",
            "format": "{all>22}  │"
        },
        {
            "type": "command",
            "key": "│  Owner        ",
            "text": "echo $USER | tr '[:lower:]' '[:upper:]'",
            "format": "{>22}  │"
        },
        {
            "type": "custom",
            "key": "│                                         │"
        },
        {
            "type": "custom",
            "key": "│     WE ARE LIBRE ! ── 我々は自由だ！    │"
        },
        {
            "type": "custom",
            "key": "╰─────────────────────────────────────────╯"
        },
        "break"
    ]
}
