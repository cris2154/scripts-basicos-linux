#!/bin/bash

# Hora por defecto
target_time="05:00"

# Procesar argumentos
while [[ "$#" -gt 0 ]]; do
  case $1 in
    -5) target_time="05:00" ;;
    -6) target_time="06:00" ;;
    -7) target_time="07:00" ;;
    -8) target_time="08:00" ;;
    -9) target_time="09:00" ;;
    -[0-9]|-[0-9][0-9]) 
      # Extraer número
      num=${1#-}
      # Formatear con un cero inicial si es de un dígito
      if [ ${#num} -eq 1 ]; then
        target_time="0${num}:00"
      else
        target_time="${num}:00"
      fi
      ;;
    -h|--help)
      echo "Uso: despertador [-5 | -6 | -7 | -hora]"
      echo "Ejemplos:"
      echo "  despertador -5      # Programa alarma para las 05:00 AM"
      echo "  despertador -7      # Programa alarma para las 07:00 AM"
      echo "  despertador -12     # Programa alarma para las 12:00 PM"
      exit 0
      ;;
    *)
      echo "Argumento no válido. Usa 'despertador --help' para ver las opciones."
      exit 1
      ;;
  esac
  shift
done

# Calcular tiempo de espera
now=$(date +%s)
target=$(date -d "$target_time" +%s)

# Si la hora ya pasó hoy, programar para mañana
if [ "$target" -le "$now" ]; then
  target=$(date -d "tomorrow $target_time" +%s)
fi

seconds_to_wait=$((target - now))

# Convertir a horas y minutos legibles
hours=$((seconds_to_wait / 3600))
minutes=$(((seconds_to_wait % 3600) / 60))

echo -e "\033[1;32mAlarma programada para las $target_time\033[0m"
echo -e "Faltan \033[1;36m$hours horas y $minutes minutos\033[0m ($seconds_to_wait segundos)."
echo "Presiona Ctrl+C para cancelar."

# Esperar el tiempo calculado
sleep $seconds_to_wait

# Activar alarma
echo -e "\n\033[1;31m¡HORA DE LEVANTARSE! ($target_time)\033[0m"
notify-send -u critical -a "Despertador" "¡Buenos días!" "Es hora de levantarse ($target_time)"

# Reproducir sonido de alerta (5 veces)
for i in {1..5}; do
  canberra-gtk-play --id="alarm-clock-elapsed" 2>/dev/null || canberra-gtk-play --id="complete" 2>/dev/null
  sleep 1
done
